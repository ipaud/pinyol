# palcycle, line_affine, line_scroll_ramp, shock, haze (the shots are read by tests/looks_check.py), and the stack, water and
# road libraries
new
tick 2
shot looks_cycle0
lua phase = 1
tick 1
shot looks_cycle1
lua phase = 0.5
tick 1
shot looks_cycle_half
lua palcycle(0, 3) mode = "none"
tick 1
shot looks_cycle_back
expect_lua_error palcycle(5, 3, 0)
lua mode = "plain"
tick 1
shot looks_plain
lua mode = "shock"
tick 1
shot looks_shock
lua mode = "haze"
tick 1
shot looks_haze
lua mode = "ramp"
tick 1
shot looks_ramp
lua mode = "affine"
tick 1
shot looks_affine
lua mode = "sil"
tick 1
shot looks_sil
lua mode = "voxel"
tick 1
shot looks_voxel
# a sky in two colours: the top row is the first, the horizon's row (40) the second, half way between half of each
lua voxels("VX", {height = "HM", colour = "CM", x = 32, y = 60, angle = -90, z = 140, horizon = 40, distance = 120, scale = 60, sky = {0x0000FF, 0xFF0000}})
expect_lua (pget(5, 0, "VX") & 0xFF) > 0xF0 and (pget(5, 0, "VX") >> 16) < 0x10
expect_lua (pget(5, 20, "VX") >> 16) > 0x70 and (pget(5, 20, "VX") >> 16) < 0x90 and (pget(5, 20, "VX") & 0xFF) > 0x70
lua mode = "road"
tick 3
shot looks_road
expect_lua select(4, rd:project(3000, 0)) == true and select(4, rd:project(0, 0)) == false and select(2, rd:project(3000, 0)) == 48 + 300 * 240 / 3000
lua flat = road.new({horizon = 48}) flat:add(2000, 0, 0)
lua bend = road.new({horizon = 48}) bend:add(2000, 2, 0)
lua hill = road.new({horizon = 48}) hill:add(2000, 0, 100)
lua flat_x, flat_y = flat:project(1000, 0) bend_x = select(1, bend:project(1000, 0)) hill_y = select(2, hill:project(1000, 0))
expect_lua bend_x > flat_x and hill_y < flat_y
lua edge = road.new({horizon = 48}) edge:add(0, 0, 100) edge:add(2000, 0, 0)
expect_lua select(2, edge:project(1000, 0)) == flat_y
# stack: the first angle's canvas is made on the first draw and has pixels in it; a second angle makes another
lua mode = "stack"
shot looks_stack0
lua found = false for y = 0, 40 do for x = 0, 30 do if pget(x, y, "SL0_stack0") then found = true end end end
expect_lua found == true
lua angle = 45
shot looks_stack
lua found2 = false for y = 0, 40 do for x = 0, 30 do if pget(x, y, "SL0_stack1") then found2 = true end end end
expect_lua found2 == true
# water: a splash in the middle moves the surface there more than at the sides, and it settles
lua mode = "water" pond:splash(240, 6)
tick 4
expect_lua math.abs(pond:height(240) - 200) > 0.5 and math.abs(pond:height(10) - 200) < math.abs(pond:height(240) - 200)
shot looks_water
tick 600
expect_lua math.abs(pond:height(240) - 200) < 0.5
expect_ok
