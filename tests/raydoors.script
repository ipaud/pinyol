# raycast() doors: shut, slid half away (a ray through the gap goes on, one on the door stops), gone; both ways a door runs; the jamb
tick 1
# the east-west door at y = 2.5, seen from (3.5, 1.5) looking south: shut it is 1 away, gone the far wall is 2.5 away
lua d, c = view(3.5, 1.5, 90, {{x = 3, y = 2, open = 0}})
expect_lua near(d, 1) and c == "E"
lua d, c = view(3.5, 1.5, 90, {{x = 3, y = 2, open = 1}})
expect_lua near(d, 2.5) and c == "#"
# the middle ray crosses the door at 0.5 of its width: slid 0.4 it still meets the door, slid 0.6 it goes through the gap
lua d, c = view(3.5, 1.5, 90, {{x = 3, y = 2, open = 0.4}})
expect_lua near(d, 1) and c == "E"
lua d, c = view(3.5, 1.5, 90, {{x = 3, y = 2, open = 0.6}})
expect_lua near(d, 2.5) and c == "#"
# without doors the square is a plain wall, at its face (0.5 away)
lua d, c = view(3.5, 1.5, 90, nil)
expect_lua near(d, 0.5) and c == "E"
# the north-south door at x = 3.5, seen from (1.5, 1.5) looking east
lua d, c = view(1.5, 1.5, 0, {{x = 3, y = 1, open = 0}})
expect_lua near(d, 2) and c == "D"
lua d, c = view(1.5, 1.5, 0, {{x = 3, y = 1, open = 1}})
expect_lua near(d, 4.5) and c == "#"
# the jamb: with the door gone, the rays at the view's sides pass into the door's square and meet the walls beside it there
lua view(3.5, 1.5, 90, {{x = 3, y = 2, open = 1}}, 0xFF0000)
lua r1, g1, b1 = rgb(20, 68) r2, g2, b2 = rgb(220, 68) r3, g3, b3 = rgb(120, 68)
expect_lua r1 > 0 and g1 == 0 and b1 == 0 and r2 > 0 and g2 == 0 and b2 == 0
expect_lua r3 == 0 and b3 > 0
# shut, the middle of the view is the door's colour, and a door's square out of the map is ignored
lua view(3.5, 1.5, 90, {{x = 3, y = 2, open = 0}, {x = 99, y = 99}}, 0xFF0000)
lua r3, g3, b3 = rgb(120, 68)
expect_lua g3 > 0 and r3 == 0 and b3 == 0
# fog_colour: past the fog's reach a wall is that colour, not black (the far wall 2.5 away, fog 2); none: black as before
lua raycast("VIEW", {map = MAP, walls = WALLS, x = 3.5, y = 1.5, angle = 90, doors = {{x = 3, y = 2, open = 1}}, fog = 2, fog_colour = 0xFF0000})
lua r3, g3, b3 = rgb(120, 68)
expect_lua r3 > 200 and g3 == 0 and b3 == 0
lua raycast("VIEW", {map = MAP, walls = WALLS, x = 3.5, y = 1.5, angle = 90, doors = {{x = 3, y = 2, open = 1}}, fog = 2})
lua r3, g3, b3 = rgb(120, 68)
expect_lua r3 == 0 and g3 == 0 and b3 == 0
lua raycast("VIEW", {map = MAP, walls = WALLS, x = 3.5, y = 1.5, angle = 90, doors = {{x = 3, y = 2, open = 1}}, fog = 5, fog_colour = 0xFF0000})
lua r3, g3, b3 = rgb(120, 68)
expect_lua r3 > 60 and r3 < 200 and b3 > 60 and b3 < 200
# lights: in the dark (fog 2 to black, the far blue wall 2.5 away) a light near the wall shows it, in its own colour times the wall's
lua L = {map = MAP, walls = WALLS, x = 3.5, y = 1.5, angle = 90, doors = {{x = 3, y = 2, open = 1}}, fog = 2}
lua L.lights = {{x = 3.5, y = 3.5, radius = 2}} raycast("VIEW", L) r3, g3, b3 = rgb(120, 68)
expect_lua b3 > 60 and r3 == 0 and g3 == 0
lua L.lights = {{x = 3.5, y = 3.5, radius = 2, colour = 0xFF0000}} raycast("VIEW", L) r3, g3, b3 = rgb(120, 68)
expect_lua r3 == 0 and g3 == 0 and b3 == 0
lua L.lights = {{x = 3.5, y = 3.5, radius = 0.3}} raycast("VIEW", L) r3, g3, b3 = rgb(120, 68)
expect_lua r3 == 0 and g3 == 0 and b3 == 0
# a light brighter nearer: the far wall in the middle of the view (nearest the light) brighter than further along it
lua L.lights = {{x = 3.5, y = 3.6, radius = 1.5}} raycast("VIEW", L) _, _, bm = rgb(120, 68) _, _, be = rgb(70, 68)
expect_lua bm > be
# in a mist the mist hides a light as it hides the wall: past its reach, the mist's colour only
lua L.fog_colour = 0xFF0000 L.lights = {{x = 3.5, y = 3.5, radius = 2}} raycast("VIEW", L) r3, g3, b3 = rgb(120, 68)
expect_lua r3 > 200 and g3 == 0 and b3 == 0
shot puerta
expect_ok
