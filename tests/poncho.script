# Poncho, the giant playroom: the title and "how it works", a walk that becomes a run, a short and a long jump (coyote time, a buffered jump), the toy keyboard
# (checkpoint), the scooter (push, drift, brake), a ramp over a gap, a toy that hurts and one jumped on, a pit and the respawn, the end flag and the results.
new
tick 90
# perf("pics"): the pictures of the last frame, dearest first (the first call starts the measuring)
lua perf("pics", 4)
tick 3
lua PP = perf("pics", 4)
expect_lua type(PP) == "table" and rawlen(PP) <= 4
expect_lua G.state == "title"
shot title
lua HOW()
tick 4
expect_lua G.state == "explain"
shot how
press RIGHT
tick 2
shot how2
press RIGHT
tick 2
shot how3
press RIGHT
tick 2
expect_lua require("core.screens").how.page == 1
press B
tick 2
expect_lua G.state == "title"
press DOWN
tick 3
press UP
tick 3
press A
tick 60
expect_lua G.state == "play" and D.state().ground
shot start

# walking: a ramp up to the walking speed, then the run by itself after a moment, and a slide when let go
hold RIGHT 20
expect_lua D.state().vx > 1.8 and D.state().vx < 2.4
hold RIGHT 80
expect_lua D.state().vx > 3.9
shot run
tick 40
expect_lua D.state().vx == 0

# the jump: a tap is a hop, a held jump is three tiles, coyote time and the buffer
expect_lua D.jump_height(1) < 30
expect_lua D.jump_height(40) > 95
expect_lua D.coyote(0) and D.coyote(5)
expect_lua not D.coyote(8)
expect_lua D.buffer(5) and not D.buffer(9)
lua D.tp(400)
in 16 RIGHT+A
expect_lua not D.state().ground
shot jump
tick 70
expect_lua D.state().ground

# the toy keyboard is a friend: touching it keeps the place and plays a tune
lua D.tp(1780)
hold RIGHT 40
expect_lua D.state().cp == 1840
shot keyboard
tick 40

# the scooter lies on the way: it is found, B gets off and on again
hold RIGHT 60
expect_lua D.state().scooter
shot scooter_found
press B
tick 2
expect_lua not D.state().scooter
press B
tick 2
expect_lua D.state().scooter

# push, glide with the speed kept, drift when changing direction, brake
lua D.tp(1620) D.clear() D.scooter(true)
hold RIGHT 70
expect_lua D.state().vx > 6
shot scooter
tick 30
expect_lua D.state().vx > 5
hold LEFT 12
shot drift
expect_lua D.state().vx < 5
hold DOWN 30
expect_lua math.abs(D.state().vx) < 2
tick 30

# a ramp throws the scooter over the gap (160 px) and it lands on the far side
lua D.tp(2000) D.scooter(true)
hold RIGHT 62
expect_lua D.state().x > 2100
shot ramp_up
tick 14
shot ramp_air
tick 40
expect_lua D.state().x > 2530 and D.state().y > 340
shot ramp_landed
expect_lua D.state().hs == "play"

# a toy rolls into him: a heart is lost, and a moment of being safe; one jumped on is beaten
lua D.tp(130) D.clear() D.scooter(false)
lua D.foe("car", 170)
tick 120
expect_lua D.state().hearts == 2
shot hurt
tick 60
lua D.tp(130) D.clear() D.foe("robot", 80)
expect_lua D.foes_alive() == 1
in 16 RIGHT+A
tick 30
shot stomp
expect_lua D.foes_alive() == 0

# costumes. The barretina is found on the floor; a tap of C is the headbutt, which breaks the two crates in the way
lua D.new_crates() D.tp(560) D.clear()
hold RIGHT 40
expect_lua D.state().costume == "barretina"
shot cos_pickup
lua D.tp(2020) D.clear()
expect_lua D.tile(66, 10) == "K" and D.tile(67, 10) == "K"
in 4 C
tick 5
expect_lua D.state().pw == "dash"
shot cos_barretina
tick 20
expect_lua D.tile(66, 10) == " " and D.tile(67, 10) == " " and D.state().crates == 2
# the headbutt beats a toy car and the costume stays
lua D.tp(130) D.clear() D.foe("car", 140) Hero_hearts_reset = require("core.hero") Hero_hearts_reset.hearts = 3
in 4 C
tick 22
expect_lua D.foes_alive() == 0 and D.state().hearts == 3 and D.state().costume == "barretina"
# the dinosaur: fire beats a robot and not a ball; down in the air is a pound that breaks the crates beside it
lua D.tp(130) D.clear() D.costume("dino") D.foe("ball", 120, 2)
in 4 C
tick 12
shot cos_fire
tick 30
expect_lua D.foes_alive() == 1 and D.state().costume == "dino"
lua D.tp(130) D.clear() D.foe("robot", 90, 2)
in 4 C
tick 22
expect_lua D.foes_alive() == 0
lua D.tp(4770) D.clear()
in 10 A
hold DOWN 2
tick 8
shot cos_pound
tick 20
expect_lua D.tile(150, 10) == " " and D.tile(151, 10) == " " and D.state().crates == 4
lua D.tp(3010, 256) D.clear()
tick 4
in 10 A
hold DOWN 2
tick 30
expect_lua D.tile(95, 7) == " " and D.state().crates == 6
# the boots: a jump, then a splash jump in the air reaches the secret shelf over the robots (six tiles up)
lua D.tp(3830) D.clear()
hold RIGHT 20
expect_lua D.state().costume == "boots"
lua D.tp(3920) D.clear()
in 14 RIGHT+A
in 4 RIGHT+A+C
shot cos_boots
in 36 RIGHT+A
tick 30
expect_lua D.state().ground and D.state().y < 170
# the football shirt: a dash and five seconds of being faster and unbeatable, toys it touches are beaten
lua D.tp(3200) D.clear() D.costume("futbol") D.foe("car", 200)
in 4 C
tick 6
expect_lua D.state().fut > 200
shot cos_futbol
hold RIGHT 30
expect_lua D.state().vx > 5.2 and D.foes_alive() == 0 and D.state().hearts == 3
# a hit costs the costume, not a heart, and a death takes it
lua D.tp(600) D.clear() D.costume("dino")
tick 140
lua D.hit()
expect_lua D.state().hearts == 3 and D.state().costume == nil and D.state().inv > 0
shot cos_lost

# a pit: he falls, the iris closes and he comes back at the keyboard
lua D.tp(1290)
hold RIGHT 100
tick 100
expect_lua D.state().deaths == 1 and D.state().x < 1900 and D.state().x > 1700 and D.state().hs == "play"
shot respawn

# the end of the playroom: the last screen is the arena of Capitan Cuerda. The camera and the walls close on it, the flag is shut, and he is beaten by stomps
# on his head when he is stunned (the hero cannot be hurt in this test: the fight's patterns are what is looked at)
lua D.tp(5760) D.clear()
tick 120
expect_lua require("core.boss").active() and D.state().cam == 5664
shot boss1
expect_lua require("core.boss").info().hp == 6
lua D.fight(true)
tick 600
shot boss1_fight
tick 2200
expect_lua require("core.boss").beaten()
tick 140
shot boss1_down
expect_lua require("core.hero").bounds == nil and require("core.cam").lock == nil
lua D.fight(false) D.tp(5900)
hold RIGHT 90
expect_lua D.state().play == "goal"
shot win
tick 230
expect_lua G.state == "results" and require("core.worlds").done(1)
tick 100
shot results
press A
tick 4
expect_lua G.state == "play" and require("core.play").world == 2
# the little bot plays the playroom as far as the boss (it wears and uses the costumes it finds)
lua D.world(1) D.bot(true)
tick 2600
expect_lua require("core.boss").active() or D.state().x > 5600
expect_lua D.state().crates >= 1
lua D.bot(false)
# the world select: the playroom is done, the market is open, the other two are not
lua G.state = "select" require("core.screens").select.enter(1) require("core.music").stop()
tick 3
shot select
expect_lua require("core.worlds").unlocked(2) and not require("core.worlds").unlocked(3)
press RIGHT
tick 2
press RIGHT
tick 2
press A
tick 2
expect_lua G.state == "select"
press LEFT
tick 2
press A
tick 30
expect_lua G.state == "play" and require("core.play").world == 2
shot w2_start

# world 2: a belt carries him, an awning bounces him, a peel patch is slippery, a cart rolls over the pit, the market's toys
lua D.new_crates() D.tp(1000) D.clear()
tick 30
expect_lua D.state().x < 975
shot w2_belt
lua D.tp(2320, 270) D.clear()
tick 12
expect_lua D.state().vy < -8
shot w2_awning
lua D.tp(2420) D.clear()
hold RIGHT 24
tick 12
expect_lua D.state().vx > 1.2
lua D.new_crates() D.tp(3210) D.clear()
tick 70
expect_lua D.state().ground and D.state().x > 3235 and D.state().deaths == 0
shot w2_cart
lua D.tp(2830) D.clear() D.costume("barretina") D.foe("melon", 100, 3)
in 4 C
tick 24
expect_lua D.foes_alive() == 1
lua D.tp(500) D.clear() D.foe("apple", 0, 3) D.tp(500, 270)
tick 14
expect_lua D.foe_state("apple").mode == "roll"
shot w2_apple
lua D.tp(2000) D.clear() D.foe("banana", 200, 6)
tick 85
expect_lua D.foe_state("banana").mode == "slide"
lua D.tp(3800) D.clear() D.foe("bee", 110, 3) D.watch_bee()
tick 500
expect_lua G.seen_dive
shot w2_bee
lua D.world(2)
expect_lua rawlen(D.cherries()) == 4 and D.cherries()[1] ~= D.cherries()[2]
# the bot plays the market to the arena of Mama Sandia
lua D.bot(true)
tick 4800
expect_lua require("core.boss").active() or D.state().x > 6000
lua D.bot(false) D.tp(6100) D.clear()
tick 100
expect_lua require("core.boss").active() and D.state().cam == 6048
shot boss2
lua D.fight(true)
tick 900
shot boss2_fight
tick 2400
expect_lua require("core.boss").beaten()
lua D.fight(false) D.tp(6250)
hold RIGHT 100
expect_lua D.state().play == "goal"
tick 230
expect_lua G.state == "results" and require("core.worlds").done(2)
tick 100
shot results2
# the flag of world 2 offers the next world (A) or the select (B); B: the select, where the chalk park is now open and the keyboard stage is not
press B
tick 4
expect_lua G.state == "select" and require("core.worlds").unlocked(3) and not require("core.worlds").unlocked(4)
press RIGHT
tick 2
shot select3
press A
tick 30
expect_lua G.state == "play" and require("core.play").world == 3
shot w3_start

# world 3, the chalk park: hopscotch (the first landing cracks a square, the second makes it vanish), puddles, a seesaw, swings, the park's toys
expect_lua require("core.map").cols == 240 and D.tile(26, 11) == "H"
lua D.clear() D.tp(848, 300)
tick 20
expect_lua D.tile(26, 11) == "h"
shot w3_hop
lua D.tp(848, 300)
tick 40
expect_lua D.tile(26, 11) == " "
lua D.new_crates()
expect_lua D.tile(26, 11) == "H"
lua D.tp(1440) D.clear()
hold RIGHT 70
expect_lua D.state().vx < 3.6
shot w3_puddle
lua D.tp(1440) D.clear() D.costume("boots")
hold RIGHT 70
expect_lua D.state().vx > 3.9
lua D.costume(nil) D.tp(2128, 300) D.clear()
in 14 RIGHT
expect_lua D.state().vy < -9
shot w3_seesaw
hold RIGHT 70
tick 80
expect_lua D.state().ground and D.state().y < 200
lua D.tp(3400, 200) D.clear()
tick 3
lua local p = require("core.level").plats[1] D.tp(p.x + 64, p.y - 40)
tick 30
expect_lua D.state().ground and D.state().y > 330 and D.state().y < 372 and D.state().deaths == 0
shot w3_swing
lua D.tp(300) D.clear() D.foe("pigeon", 120, 3)
tick 128
expect_lua D.foe_state("pigeon").mode == "peck"
lua D.tp(300) D.clear() D.foe("snail", 0, 3) D.tp(300, 270)
tick 14
expect_lua D.foe_state("snail").mode == "shell"
shot w3_snail
lua D.tp(300) D.clear() D.foe("plane", 220, 3) D.foe("ball", 160, 3)
tick 60
expect_lua D.foes_alive() == 2
# the little bot plays the chalk park, from the gate to the flag
lua D.world(3) D.bot(true)
tick 2900
expect_lua G.state == "results" or D.state().x > 7400
tick 300
shot results3
expect_lua G.state == "results" and require("core.worlds").done(3) and not require("core.worlds").next_ready(3)
lua D.bot(false)
press B
tick 4
expect_lua G.state == "select"
press B
tick 4
expect_lua G.state == "title"
shot title_continue
expect_lua rawlen(achievements()) == 13
expect_lua (function() local n = 0 for _, a in ipairs(achievements()) do if a.done then n = n + 1 end end return n >= 9 end)()
expect_ok
